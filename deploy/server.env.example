# /etc/spectrevoice/server.env (chmod 640, root:spectrevoice). install.sh fills it in; change it, then
# systemctl restart spectrevoice.
SV_LISTEN=:7880
SV_DATA=/var/lib/spectrevoice
SV_NAME=Spectre Voice
SV_MOTD=
# Server password ('' = open)
SV_PASSWORD=
SV_MAX_USERS=200
# Owners' uids (app: Settings › Identity), comma separated. Or claim the server from the app with the code
# install.sh prints (/var/lib/spectrevoice/claim.code).
SV_OWNERS=
# Voice: the address the apps reach. LAN only: this machine's LAN IP. Open to the internet: the public IP or DDNS
# name (the LAN keeps working).
SV_PUBLIC_IP=
SV_UDP_MIN=50000
SV_UDP_MAX=50200
# TURN relay for networks that block UDP (install.sh sets up coturn with a domain)
SV_TURN=
SV_TURN_USER=
SV_TURN_PASS=
# Voice quality where a channel sets none: 1 low (16k) · 2 standard (32k) · 3 high (64k) · 4 music (96k stereo)
# · 5 studio (160k, Pro) · 6 max (256k, Pro)
SV_AUDIO_QUALITY=3
# Who may make new communities: anyone (a few each), staff (the owners and admins)
SV_CREATE_COMMUNITIES=anyone
# Invite links as https://voice.example.com/i/CODE (default: this server's address + /i/)
SV_INVITE_BASE=
# Music bot (!play in a channel's chat): needs ffmpeg and yt-dlp
SV_MUSIC=true
# Shared files: largest file (MB; the tier may lower it), days kept
SV_FILE_MAX_MB=100
# Pro: the licence service (the key is typed in the app: Server › Licence)
SV_LICENSE_URL=https://license.spectrevoice.com
# Push notifications: a Firebase service account key (JSON), readable only by the service
SV_PUSH_CREDENTIALS=
# Google Play donations (service account JSON)
SV_PLAY_CREDENTIALS=
SV_PLAY_PACKAGE=io.github.stefan3dx.spectrevoice
SV_CONTACT_EMAIL=
# App updates served from GitHub releases (a token when the repo is private)
SV_UPDATES=false
SV_UPDATES_REPO=Stefan3Dx/SpectreVoice
SV_GITHUB_TOKEN=
