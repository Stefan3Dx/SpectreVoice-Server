# /etc/spectrevoice/server.env (chmod 640, root:spectrevoice). install.sh fills it in; change it, then
# systemctl restart spectrevoice.
SV_LISTEN=:7880
SV_DATA=/var/lib/spectrevoice
# The server's name and password ('' = open to anyone with the address). Admins can change both in the app
# (Server settings); what they set there wins over these lines (kept in the server's database, the password hashed).
SV_NAME=Spectre Voice
SV_MOTD=
SV_PASSWORD=
# Your own cap on people connected at once (0: the places alone: 30, plus 30 days of extra places per donation)
SV_MAX_USERS=0
# Owners' uids (app: Settings › Identity), comma separated. Or claim the server from the app with the code
# install.sh prints (/var/lib/spectrevoice/claim.code).
SV_OWNERS=
# Voice: the address the apps reach. LAN only: this machine's LAN IP. Open to the internet: the public IP or DDNS
# name (the LAN keeps working).
SV_PUBLIC_IP=
SV_UDP_MIN=50000
SV_UDP_MAX=50200
# One UDP port for everything instead of the range (hosting panels): SV_UDP_PORT=7880
# A hosting partner's plan code (set by the host): SV_PARTNER_CODE=
# TURN relay for networks that block UDP (install.sh sets up coturn with a domain). With coturn's use-auth-secret,
# SV_TURN_SECRET (its static-auth-secret) gives each person credentials of their own that end, instead of the
# fixed user and password.
SV_TURN=
SV_TURN_USER=
SV_TURN_PASS=
SV_TURN_SECRET=
# Voice quality where a channel sets none: 1 low (16k) · 2 standard (32k) · 3 high (64k) · 4 music (96k stereo)
# · 5 studio (160k, Pro) · 6 max (256k, Pro)
SV_AUDIO_QUALITY=3
# Invite links as https://voice.example.com/i/CODE (default: this server's address + /i/)
SV_INVITE_BASE=
# Music bot (!play in a channel's chat): needs ffmpeg and yt-dlp.
# Privacy: "!play words" searches YouTube from this server (the words leave it); a link plays only that link.
SV_MUSIC=true
# The server's TV: an IPTV channel (M3U playlist, set in the app by those with the TV permission) everyone watches
# like a stream. Needs ffmpeg (installed with the music bot). Picture at most SV_TV_HEIGHT lines and SV_TV_KBPS;
# off after SV_TV_IDLE seconds with nobody watching. Only public addresses, unless SV_TV_LAN=true (LAN sources).
# SV_TV_VIDEO: auto (graphics card through VAAPI when it works, else x264), vaapi, x264.
SV_TV=true
SV_TV_LAN=false
SV_TV_KBPS=3000
SV_TV_HEIGHT=720
SV_TV_IDLE=90
SV_TV_VIDEO=auto
# The server's soundboard: admins upload short sounds (ffmpeg makes them Opus, ≤ 10 s), everyone plays them in voice
SV_SOUNDBOARD=true
SV_SOUNDS_MAX=100
# Shared files: largest file (MB; the tier may lower it), days kept, all of them, the chat's
SV_FILE_MAX_MB=100
SV_FILE_DAYS=30
SV_FILE_QUOTA_MB=5120
SV_FILE_SPACE_MB=1024
# The donation service: a donation for this server adds places for 30 days (a code is typed in the app: Server)
SV_LICENSE_URL=https://license.spectrevoice.com
# Push notifications: a Firebase service account key (JSON), readable only by the service
SV_PUSH_CREDENTIALS=
# What a notification carries through Google: false = only that there's a message (default); true = who and what
SV_PUSH_CONTENT=false
# Google Play donations (service account JSON)
SV_PLAY_CREDENTIALS=
SV_PLAY_PACKAGE=io.github.stefan3dx.spectrevoice
# Your e-mail for people's data requests (GDPR: you hold their data), shown at /privacy
SV_CONTACT_EMAIL=
# App updates served from GitHub releases (a token when the repo is private)
SV_UPDATES=false
SV_UPDATES_REPO=Stefan3Dx/SpectreVoice-Releases
SV_GITHUB_TOKEN=
# Backups: daily at SV_BACKUP_HOUR (server time; -1: none), the newest SV_BACKUP_KEEP kept in SV_BACKUP_DIR
# (default /var/lib/spectrevoice/backups; 0700, each backup 0600: they hold the server's secrets)
SV_BACKUP_HOUR=3
SV_BACKUP_KEEP=14
#SV_BACKUP_DIR=/var/lib/spectrevoice/backups
# Temporary channels: deleted after SV_TEMP_EMPTY seconds empty; per person at once; on the server at once
SV_TEMP_EMPTY=60
SV_TEMP_PER_USER=1
SV_TEMP_MAX=20
# Scheduled events: people are told this many minutes before (and at the start)
SV_EVENT_LEAD=15
# The most Lei the owner (or whom the owner lets) adds or takes in one grant
SV_LEI_MAX=100000
